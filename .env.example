# Copy to .env – every value is optional; the backend runs with none of them.

# Storage (SQLite by default; Postgres works with SQLAlchemy installed:
# postgresql+psycopg://user:pass@localhost:5432/cartpilot)
CARTPILOT_DATABASE_URL=sqlite:///./cartpilot.db

# Time zone for deadlines. CARTPILOT_FIXED_NOW pins the clock for repeatable demos (HH:MM).
CARTPILOT_TIMEZONE=Asia/Kolkata
# CARTPILOT_FIXED_NOW=17:00

# Member B's mock store API. Unset = built-in temporary mock store.
# CARTPILOT_STORE_URL=http://127.0.0.1:8001
CARTPILOT_TOOL_TIMEOUT_S=5
CARTPILOT_TOOL_MAX_RETRIES=2

# Teammate modules (dotted paths). If import fails, the built-in fallback is used.
CARTPILOT_MATCHING_MODULE=app.agents.matching_agent
CARTPILOT_OPTIMIZER_MODULE=app.optimizer.optimizer
CARTPILOT_PRICE_HISTORY_MODULE=app.adapters.price_history

# Agent behaviour
CARTPILOT_MAX_REPLANS=3
CARTPILOT_FEE_ANOMALY_PCT=0.25
CARTPILOT_FEE_ANOMALY_ABS=10

# Optional LLM for intent parsing (any OpenAI-compatible endpoint). Unset = deterministic parser.
# Free local option: Ollama ->  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=llama3.1

# Demo fault injection endpoint (/api/dev/faults). Off by default; true only for local demos/tests.
CARTPILOT_ENABLE_FAULTS=true
CARTPILOT_CORS_ORIGINS=http://localhost:3000,http://localhost:8501
