# CartPilot - copy this file to `.env` in the project root and fill in
# YOUR values. Never commit `.env` - add it to .gitignore. Never paste
# the real password into chat, a deck, or a README.
#
# Local Neo4j Desktop (the CartPilot instance in your screenshot):
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD= 
#
# If you switch to AuraDB Free instead, replace the URI line with your
# Aura URI, e.g.:
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-aura-password-here
